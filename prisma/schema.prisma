generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                 String                 @id @default(uuid())
  name               String
  description        String?
  price              Decimal
  priceApps          Decimal?
  pricePedidosYa     Decimal?
  priceRappi         Decimal?
  priceMP            Decimal?
  categoryId         String?
  image              String?
  isActive           Boolean                @default(true)
  isPromo            Boolean                @default(false)
  promoDiscount      Float                  @default(0)
  isPromoApps        Boolean                @default(false)
  promoDiscountApps  Float                  @default(0)
  isPromoPY          Boolean                @default(false)
  promoDiscountPY    Float                  @default(0)
  isPromoRappi       Boolean                @default(false)
  promoDiscountRappi Float                  @default(0)
  isPromoMP          Boolean                @default(false)
  promoDiscountMP    Float                  @default(0)
  showPublic         Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  comboSlots         ComboSlot[]            @relation("ComboSlots")
  comboDefaults      ComboSlot[]            @relation("SlotDefault")
  comboAlternatives  ComboSlotAlternative[] @relation("SlotAlternatives")
  category           Category?              @relation(fields: [categoryId], references: [id])
  usedAsExtra        ProductExtra[]         @relation("ExtraProduct")
  allowedExtras      ProductExtra[]         @relation("MainProduct")
  recipe             RecipeItem[]
  sales              SaleItem[]
  channelMappings    ProductChannelMapping[]
  channelPricings    ProductChannelPricing[]
  syncJobs           SyncJob[]
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Ingredient {
  id           String         @id @default(uuid())
  name         String
  unit         String
  cost         Decimal
  stock        Decimal
  minStock     Decimal
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  priceHistory PriceHistory[]
  recipeItems  RecipeItem[]
  wasteLogs    WasteLog[]
}

model PriceHistory {
  id           String     @id @default(uuid())
  ingredientId String
  cost         Decimal
  date         DateTime   @default(now())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
}

model RecipeItem {
  id           String     @id @default(uuid())
  productId    String
  ingredientId String
  quantity     Decimal
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])
}

model Sale {
  id            String     @id @default(uuid())
  date          DateTime   @default(now())
  total         Decimal
  discount      Decimal    @default(0)
  paymentMethod String
  channel       String
  clientName    String?
  customerId    String?
  status        String     @default("COMPLETED")
  customer      Customer?  @relation(fields: [customerId], references: [id])
  items         SaleItem[]
}

model SaleItem {
  id                  String                @id @default(uuid())
  saleId              String
  productId           String
  quantity            Int
  unitPrice           Decimal
  product             Product               @relation(fields: [productId], references: [id])
  sale                Sale                  @relation(fields: [saleId], references: [id])
  SaleItemFulfillment SaleItemFulfillment[]
}

model Expense {
  id          String   @id @default(uuid())
  date        DateTime
  category    String
  amount      Decimal
  description String?
  isFixed     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Customer {
  id           String    @id @default(uuid())
  name         String?
  phone        String?   @unique
  email        String?
  lastPurchase DateTime?
  totalSpent   Decimal   @default(0)
  createdAt    DateTime  @default(now())
  sales        Sale[]
}

model WasteLog {
  id           String      @id @default(uuid())
  date         DateTime    @default(now())
  description  String
  cost         Decimal
  ingredientId String?
  quantity     Decimal?
  createdAt    DateTime    @default(now())
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
}

model BrainKnowledge {
  id        String   @id @default(uuid())
  content   String
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformConfig {
  id                String   @id @default(uuid())
  name              String   @unique
  commission        Float    @default(0)
  isEnabled         Boolean  @default(false)
  integrationStatus String   @default("NOT_CONNECTED")
  costRules         Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mappings          ProductChannelMapping[]
  pricings          ProductChannelPricing[]
  syncJobs          SyncJob[]
}

model ProductExtra {
  id             String  @id @default(uuid())
  mainProductId  String
  extraProductId String
  extraProduct   Product @relation("ExtraProduct", fields: [extraProductId], references: [id])
  mainProduct    Product @relation("MainProduct", fields: [mainProductId], references: [id])

  @@unique([mainProductId, extraProductId])
}

model StoreHours {
  id        String   @id @default(uuid())
  dayOfWeek Int      @unique
  isOpen    Boolean  @default(true)
  shifts    Json
  updatedAt DateTime @updatedAt
}

model ComboSlot {
  id               String                 @id @default(uuid())
  comboId          String
  name             String
  defaultProductId String
  sortOrder        Int                    @default(0)
  combo            Product                @relation("ComboSlots", fields: [comboId], references: [id], onDelete: Cascade)
  defaultProduct   Product                @relation("SlotDefault", fields: [defaultProductId], references: [id])
  alternatives     ComboSlotAlternative[]
  fulfillments     SaleItemFulfillment[]
}

model ComboSlotAlternative {
  id         String    @id @default(uuid())
  slotId     String
  productId  String
  product    Product   @relation("SlotAlternatives", fields: [productId], references: [id])
  slot       ComboSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  extraPrice Float     @default(0)
}

model SaleItemFulfillment {
  id                  String    @id @default(uuid())
  saleItemId          String
  slotId              String
  configuredProductId String
  deliveredProductId  String
  replacementReason   String?
  createdAt           DateTime  @default(now())
  saleItem            SaleItem  @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  slot                ComboSlot @relation(fields: [slotId], references: [id])
}

model ProductChannelMapping {
  id                 String         @id @default(uuid())
  productId          String
  platformId         String
  externalProductId  String?
  externalSku        String?
  externalCategoryId String?
  syncStatus         String         @default("PENDING")
  lastSyncedAt       DateTime?
  lastError          String?
  
  product            Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform           PlatformConfig @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([productId, platformId])
}

model ProductChannelPricing {
  id                    String         @id @default(uuid())
  productId             String
  platformId            String
  rule                  String         @default("MANUAL") // MANUAL, PERCENTAGE, NET_TARGET
  value                 Decimal        @default(0) // Price, or percentage markup depending on rule
  isPromo               Boolean        @default(false)
  promoDiscount         Float          @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  
  product               Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform              PlatformConfig @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([productId, platformId])
}

model SyncJob {
  id             String         @id @default(uuid())
  productId      String
  platformId     String
  operation      String
  payload        Json?
  status         String         @default("PENDING")
  attempts       Int            @default(0)
  lastAttemptAt  DateTime?
  nextRetryAt    DateTime?
  responseStatus Int?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform       PlatformConfig @relation(fields: [platformId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  productId     String?
  platformId    String?
  action        String
  previousValue Json?
  newValue      Json?
  result        String
  error         String?
  timestamp     DateTime @default(now())
}
